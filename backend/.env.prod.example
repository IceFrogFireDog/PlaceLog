# 운영 배포 설정. 복사해서 .env.prod로 저장하고 값을 채운다. .env.prod는 Git에 올리지 않는다.
# 주석은 줄 맨 앞에만 쓴다.

# 서비스 주소(도메인). Caddy가 이 이름으로 HTTPS 인증서를 자동 발급한다.
DOMAIN=photos.example.com

# 프론트엔드 폴더 (이 파일 기준 상대 경로). 기본은 같은 저장소의 frontend/
FRONTEND_DIR=../frontend

# DB 비밀번호: 영문·숫자만 (주소에 그대로 들어감). 생성: openssl rand -hex 24
POSTGRES_PASSWORD=
# 32자 이상 랜덤값. 생성: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 이메일 인증·비밀번호 재설정 메일 발송 (SMTP)
MAIL_BACKEND=smtp
MAIL_FROM=지구본 사진 <no-reply@photos.example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

# 장소 검색: nominatim(공용 서버는 초당 1회·소규모만) / kakao(키 필요) / none
GEOCODER=nominatim
GEOCODER_CONTACT_EMAIL=admin@example.com
KAKAO_REST_API_KEY=

# 사진 저장소: local(서버 볼륨) 또는 object(S3 호환, 버킷은 비공개로)
STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=

# 지도 타일 (프론트엔드 빌드 때 고정). 비우면 OpenStreetMap 공용 타일(소규모 이용만 허용).
# 사용자가 많아지면 상용·자체 타일 서버 주소와 출처 표시로 바꿀 것.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# 개인정보 처리 안내(/privacy)에 표시할 운영 정보 (프론트엔드 빌드 때 고정)
NEXT_PUBLIC_PRIVACY_OFFICER=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_PRIVACY_PROCESSORS=
NEXT_PUBLIC_PRIVACY_EFFECTIVE_DATE=
