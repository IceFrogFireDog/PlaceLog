# 이 파일을 .env로 복사해 값을 채웁니다. .env는 Git에 올리지 않습니다.
# 주석은 항상 줄 맨 앞에 씁니다(값 뒤에 붙이면 도구에 따라 값으로 읽힐 수 있음).

# ---- 개발용 DB: `docker compose up -d db`가 이 값으로 PostgreSQL을 만듭니다 (바꾸면 DATABASE_URL도 같이) ----
POSTGRES_USER=photoglobe
POSTGRES_PASSWORD=change-me
POSTGRES_DB=photoglobe

DATABASE_URL=postgresql+psycopg://photoglobe:change-me@localhost:5432/photoglobe
# 필수. 32자 이상 랜덤값: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_TTL_SECONDS=1209600
# 로컬 http 개발에서만 false. 배포(https)에서는 반드시 true
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000
# 메일 속 링크(이메일 인증·비밀번호 재설정)가 가리킬 화면 주소
FRONTEND_BASE_URL=http://localhost:3000

# ---- 사진 저장소: local 또는 object(S3 호환) ----
STORAGE_BACKEND=local
# 상대 경로는 이 백엔드 폴더 기준
LOCAL_STORAGE_PATH=./storage
# STORAGE_BACKEND=object일 때. AWS S3는 ENDPOINT_URL을 비우고, R2·MinIO·NCP 등은 주소를 넣습니다.
# 버킷은 공개 접근을 막아 두세요. 사진은 항상 백엔드가 권한을 확인한 뒤 전달합니다.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=

MAX_UPLOAD_BYTES=20971520
# 카메라 RAW(DNG·CR2·NEF·ARW 등) 한도. 0이면 RAW를 받지 않음. 프록시 한도(next.config.ts, Caddyfile)도 함께 조정
MAX_RAW_UPLOAD_BYTES=83886080
MAX_IMAGE_PIXELS=80000000
IMAGE_WORKERS=2

# ---- 이메일 인증·비밀번호 재설정 ----
# true면 인증 전에는 사진 등록·장소 생성·친구 요청이 막힙니다(둘러보기·프로필 수정은 가능)
EMAIL_VERIFICATION_REQUIRED=true
VERIFY_TOKEN_TTL_SECONDS=86400
RESET_TOKEN_TTL_SECONDS=3600
# file: 실제로 보내지 않고 MAIL_FILE_DIR에 .eml로 저장(개발용) / smtp: 실제 발송 / none: 보내지 않음
MAIL_BACKEND=file
MAIL_FILE_DIR=./dev-mail
MAIL_FROM=지구본 사진 <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# 465 포트(SSL 직접 연결)면 true, STARTTLS는 false
SMTP_SSL=false

# ---- 장소 검색(지도에서 고르기·주소 자동 채우기) ----
# nominatim(OpenStreetMap, 키 불필요) / kakao(국내 검색 품질 좋음, REST 키 필요) / none(끄기)
GEOCODER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# 공용 Nominatim 이용 정책: 앱을 식별하는 User-Agent 필수, 초당 1회 이하. 서버가 자동으로 지킵니다.
GEOCODER_USER_AGENT=photo-globe/0.2
# 운영자 연락처(권장). User-Agent 뒤에 붙습니다.
GEOCODER_CONTACT_EMAIL=
KAKAO_REST_API_KEY=
GEOCODE_CACHE_SECONDS=86400

# ---- 빈도 제한: memory(서버 1대) 또는 redis(여러 대가 공유) ----
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
