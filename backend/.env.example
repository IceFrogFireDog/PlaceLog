# 이 파일을 .env로 복사해 값을 채웁니다. .env는 Git에 올리지 않습니다.
# 주석은 항상 줄 맨 앞에 씁니다(값 뒤에 붙이면 도구에 따라 값으로 읽힐 수 있음).

# ---- 개발용 DB: `docker compose up -d db`가 이 값으로 PostgreSQL을 만듭니다 (바꾸면 DATABASE_URL도 같이) ----
POSTGRES_USER=photoglobe
POSTGRES_PASSWORD=change-me
POSTGRES_DB=photoglobe

DATABASE_URL=postgresql+psycopg://photoglobe:change-me@localhost:5432/photoglobe
# 필수. 32자 이상 랜덤값: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_TTL_SECONDS=1209600
# 로컬 http 개발에서만 false. 배포(https)에서는 반드시 true
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000
