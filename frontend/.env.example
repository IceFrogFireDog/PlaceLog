# 이 파일을 .env.local로 복사해 쓴다. (값은 `next build` 시점에 고정된다)
# NEXT_PUBLIC_로 시작하는 값은 브라우저에 그대로 노출되므로 비밀을 넣지 말 것.

# 백엔드 주소. 브라우저는 /api/v1로만 호출하고 Next가 이 주소로 전달한다.
API_ORIGIN=http://localhost:8000

# 지도에서 고르기 화면의 타일 서버와 출처 표시. 비우면 OpenStreetMap 공용 타일(소규모·저빈도 이용만 허용).
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# 개인정보 처리 안내(/privacy)에 표시할 운영 정보
NEXT_PUBLIC_PRIVACY_OFFICER=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_PRIVACY_PROCESSORS=
NEXT_PUBLIC_PRIVACY_EFFECTIVE_DATE=
